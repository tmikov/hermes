// The native helpers the JS layer calls, one line each:
//   HERMES_INTL_HELPER(name, Result, Arg...)
// with no Args for a helper that takes none. Result and every Arg is a
// conversion tag from NativeHelpers.h:
//   Bool       a JS boolean
//   Object     a JS object (arguments only)
//   Utf8       a JS string as UTF-8: option strings and formatter output
//   Utf16      a JS string as UTF-16, lossless for unpaired surrogates: text
//              to compare or transform
//   OptUtf8    a JS string or undefined (results only)
//   Int        a JS number that is an integer in int range; as an
//              argument, anything else is an internal error
//   Double     a JS number that is finite (arguments only); anything else
//              is an internal error
//   Utf8List   a new JS array of strings, from a std::vector<std::string>
//              of UTF-8 (results only)
//   Undefined  undefined (results only)
// JS validates every argument first; a wrong count or type is a plugin bug,
// an internal error naming the helper.
// No include guard: this file is included once per expansion.

// (tag) The canonicalized tag, or undefined if tag is not well-formed.
HERMES_INTL_HELPER(canonicalizeLocale, OptUtf8, Utf8)
// (tag) The Add Likely Subtags result for a canonical tag, itself a canonical
// tag (RegionPreference relies on this). Throws if tag does not parse.
HERMES_INTL_HELPER(addLikelySubtags, Utf8, Utf8)
// (tag) The Remove Likely Subtags result for a canonical tag, itself a
// canonical tag. Throws if tag does not parse.
HERMES_INTL_HELPER(removeLikelySubtags, Utf8, Utf8)
// (region) The CLDR calendar types for a region ("TH", "001"), preferred
// first, space-separated. A region with no line of its own ("US") gets the
// "001" line; undefined only if region is not a region code.
HERMES_INTL_HELPER(calendarPreferences, OptUtf8, Utf8)
// (key) The CLDR hour cycles for a region or "language-REGION" key, preferred
// first, space-separated. A region with no line of its own ("AQ") gets the
// "001" line; undefined for a "language-REGION" key with no line.
HERMES_INTL_HELPER(hourCycles, OptUtf8, Utf8)
// (region) The primary IANA ids of the region's time zones ("JP", "PS"),
// sorted, space-separated; empty for a region with none.
HERMES_INTL_HELPER(timeZonesOfRegion, Utf8, Utf8)
// (region) The week data of a region ("US", "001"): the ISO number of the
// first day of the week (Monday 1 to Sunday 7), then the weekend days
// ascending, space-separated. Throws if region is not a region code.
HERMES_INTL_HELPER(weekInfo, Utf8, Utf8)
// (script) "ltr" or "rtl" for a script code ("Arab"), or undefined if unknown.
HERMES_INTL_HELPER(scriptDirection, OptUtf8, Utf8)
// (locale) The numbering system of the locale's decimal data ("latn").
// Throws if locale does not parse.
HERMES_INTL_HELPER(defaultNumberingSystem, Utf8, Utf8)
// (locale) The collation types the locale has tailorings for, sorted,
// space-separated ("emoji eor phonebk" for "de").
HERMES_INTL_HELPER(collationsOfLocale, Utf8, Utf8)
// (tag) Whether tag (canonical, without extensions) is an available locale.
HERMES_INTL_HELPER(isAvailableLocale, Bool, Utf8)
// (key) The values for Intl.supportedValuesOf(key), sorted, space-separated.
// key is "calendar", "collation", "currency", "numberingSystem" or
// "timeZone".
HERMES_INTL_HELPER(supportedValues, Utf8, Utf8)
// (locale) ICU4X's default "<caseFirst> <ignorePunctuation>" for an
// available locale ("upper false" for "da", "false true" for "th"). Throws
// if locale does not parse.
HERMES_INTL_HELPER(collatorLocaleDefaults, Utf8, Utf8)
// (collator, locale, collation, sensitivity, ignorePunctuation, numeric,
// caseFirst) Attach the native collator for these resolved options to the
// Intl.Collator instance collator. collation is "default" or a supported
// collation, sensitivity "base", "accent", "case" or "variant", caseFirst
// "upper", "lower" or "false". Throws for any other value, if there is no
// data, or if collator already has native state.
HERMES_INTL_HELPER(
    collatorInit, Undefined, Object, Utf8, Utf8, Utf8, Bool, Bool, Utf8)
// (collator, x, y) CompareStrings(collator, x, y): -1, 0 or 1. An unpaired
// surrogate compares as U+FFFD. Throws if collatorInit did not initialize
// collator.
HERMES_INTL_HELPER(collatorCompare, Int, Object, Utf16, Utf16)
// (text, language, upper) The full upper (upper true) or lower case mapping
// of text with the tailoring of language ("und", or a language tag whose
// language subtag may be az, el, hy, lt or tr). Unpaired surrogates stay where
// they are. Throws if language does not parse.
HERMES_INTL_HELPER(caseMap, Utf16, Utf16, Utf8, Bool)
// (pluralRules, locale, ordinal) Attach the native cardinal (ordinal false)
// or ordinal plural rules, with plural ranges, for the language identifier of
// locale to the Intl.PluralRules or internal object pluralRules. Throws if
// locale does not parse, if there is no data, or if pluralRules already has
// native state.
HERMES_INTL_HELPER(pluralRulesInit, Undefined, Object, Utf8, Bool)
// (pluralRules, decimal, exponent) The plural category ("zero", "one",
// "two", "few", "many" or "other") of decimal x 10^exponent. decimal is ASCII
// digits with an optional "." between digits ("1.50"); the operands keep
// every digit and trailing zero, and c is exponent when it is positive, else
// 0. Throws for any other decimal, or if pluralRulesInit did not initialize
// pluralRules.
HERMES_INTL_HELPER(pluralSelect, Utf8, Object, Utf8, Int)
// (pluralRules, startCategory, endCategory) The plural category of a range
// whose ends have these categories. Throws if either is not a category name,
// or if pluralRulesInit did not initialize pluralRules.
HERMES_INTL_HELPER(pluralSelectRange, Utf8, Object, Utf8, Utf8)
// (pluralRules) The categories of pluralRules in the order zero, one, two,
// few, many, other; "other" is always last. Throws if pluralRulesInit did not
// initialize pluralRules.
HERMES_INTL_HELPER(pluralCategories, Utf8List, Object)
// (locale, nu) The number symbols and patterns of the language identifier of
// locale and the numbering system nu, resolved as CLDR's inheritance does
// (the nearest locale of the chain that defines nu, else root's explicit data
// for nu, else the locale's latn data): 0 decimal separator, 1 group
// separator, 2 minus sign, 3 plus sign, 4 percent sign, 5 exponent
// symbol, 6 infinity, 7 NaN, 8 approximately sign; 9 primary group size,
// 10 secondary group size, 11 minimum grouping digits, as decimal strings;
// 12-14 the decimal zero, positive and negative patterns and 15-17 the
// percent ones ("{minusSign}{number}{percentSign}"); 18 the range pattern
// ("{0}–{1}"); 19 and 20 the primary and secondary group sizes of percents,
// from their own CLDR pattern (bn: 3 and 3, against 3 and 2 for decimals),
// with entry 11 as their minimum grouping too. Bidi controls of the signs are
// literal text of the patterns, and entries 2-4 are the bare signs.
// Throws if locale does not parse or nu is not a numbering system type.
HERMES_INTL_HELPER(numberSymbols, Utf8List, Utf8, Utf8)
// (locale, nu, currency, display, accounting) The currency patterns for an
// uppercase ISO currency code and currencyDisplay display, the standard or
// accounting ones; compact notation uses them for a number it does not
// compact. A currency's own pattern (CLDR's <currency type="X"><pattern>,
// en-150's EUR), resolved by UTS 35's lateral inheritance for nu and for the
// standard or accounting pattern, replaces the locale's. For "code", "symbol"
// and "narrowSymbol": 0-2 the zero, positive
// and negative patterns (accounting ones if accounting) with
// {currencyPrefix} or {currencySuffix}, with CLDR's currency spacing; 3 the
// currency string;
// 4-6 the zero, positive and negative patterns for a number whose character
// next to the currency is not a digit (NaN, infinity), which get no
// currency spacing ("USDNaN"). For "name": 0-5 the name pattern for zero,
// one, two, few, many and other, in CLDR form with the plural name
// substituted ("{0} US dollars"); a category the locale lacks gets
// other's. Throws for any other currency or display, or as numberSymbols.
HERMES_INTL_HELPER(currencyPatterns, Utf8List, Utf8, Utf8, Utf8, Utf8, Bool)
// (locale, nu, currency) The decimal and grouping separators of the currency
// style for an uppercase ISO currency code, in every display and notation:
// the currency's own (CLDR's <currency type="X"><decimal> and <group>, pt-CV's
// CVE "$"), resolved by UTS 35's lateral inheritance, in every numbering
// system; else CLDR's currencyDecimal and currencyGroup (fr-CH's ".", de-AT's
// "."), the locale's latn ones where root aliases nu's symbols to latn and
// none where root's symbols for nu are explicit (arab, arabext); else
// entries 0 and 1 of numberSymbols. Throws for any other currency, or as
// numberSymbols.
HERMES_INTL_HELPER(currencySeparators, Utf8List, Utf8, Utf8, Utf8)
// (locale, nu, currency, display, accounting) The patterns of compact
// notation with the currency style, from CLDR's short currency formats, for
// an uppercase ISO currency code and the currencyDisplay "code", "symbol" or
// "narrowSymbol" (the name display uses compactPatterns), standard or
// accounting: 0 the number N of entries, then for each entry in increasing
// magnitude 26 strings: the magnitude it starts at, its exponent (0 for a
// magnitude CLDR does not compact, whose other strings are empty), and for
// each of zero, one, two, few, many and other (a category the locale lacks
// gets other's) the compact pattern in CLDR form ("{0}K") and the zero,
// positive and negative patterns with {currencyPrefix} or {currencySuffix},
// whose {number} is the compact pattern. Throws as currencyPatterns.
HERMES_INTL_HELPER(
    compactCurrencyPatterns, Utf8List, Utf8, Utf8, Utf8, Utf8, Bool)
// (locale, nu, long) The short or long compact patterns: 0 the number N of
// entries, then for each entry in increasing magnitude 10 strings: the
// magnitude it starts at, its exponent, the exact-0 and exact-1 patterns
// (empty when it has none, or when it is the same as the pattern of the
// category of 0 or 1, which then gives the same result), and the zero, one,
// two, few, many and other patterns in CLDR form ("{0}K"; a pattern may lack
// {0}). A category the locale lacks gets other's. Throws as numberSymbols.
HERMES_INTL_HELPER(compactPatterns, Utf8List, Utf8, Utf8, Bool)
// (locale, unit, width) The unit patterns of a sanctioned unit, or X-per-Y
// of two, at width "long", "short" or "narrow": 0-5 the zero, one, two,
// few, many and other patterns in CLDR form ("{0} miles"). A category the
// locale lacks gets other's. A pattern may lack {0}, but other's has it.
// Throws for any other unit or width, or as numberSymbols.
HERMES_INTL_HELPER(unitPatterns, Utf8List, Utf8, Utf8, Utf8)
// (currency) CurrencyDigits of an uppercase ISO currency code: CLDR's
// fraction digits, 2 for a currency CLDR does not list. Throws for anything
// else.
HERMES_INTL_HELPER(currencyDigits, Int, Utf8)
// (locale, calendar) DateTimeFormat's CLDR patterns for one of the 16
// supported calendars: 0-3 the dateFormats full, long, medium, short; 4-7
// the timeFormats; 8-11 the standard dateTimeFormats; 12-15 the atTime
// dateTimeFormats (the standard ones where the locale has none); 16
// intervalFormatFallback; 17 the numeric leap month pattern ("" if none); 18
// the Timezone append item; 19 the number N of availableFormats entries,
// then N pairs (skeleton, pattern) in CLDR's order; then the number M of
// interval entries, then M triples (skeleton, greatest-difference letter,
// pattern). Throws for an unknown calendar or a locale that does not parse.
HERMES_INTL_HELPER(dateTimePatterns, Utf8List, Utf8, Utf8)
// (locale) The flexible day periods: 0 the number N of periods with a range;
// then N groups of six: id, start minute, end minute (of the day, 1440 is
// the end of the day; a start after the end wraps midnight), abbreviated,
// wide and narrow names ("" where CLDR has none); then noon's abbreviated,
// wide and narrow names ("" if the rules have no noon). Throws as
// dateTimePatterns.
HERMES_INTL_HELPER(dayPeriods, Utf8List, Utf8)
// (name) The primary identifier of an IANA time zone name, matched without
// regard to case, or undefined for a name that is not a time zone.
HERMES_INTL_HELPER(canonicalizeTimeZone, OptUtf8, Utf8)
// (dateTimeFormat, locale, calendar, timeZone, symbols) Attach the native
// state of an Intl.DateTimeFormat to dateTimeFormat: the calendar (one of the
// 16 supported ones), the time zone (a primary identifier, or "+HH:MM" or
// "-HH:MM") and the names of symbols, for the language identifier of locale.
// symbols are CLDR name symbols separated by single spaces ("" for none),
// each one of G GGGG GGGGG MMM MMMM MMMMM LLL LLLL LLLLL EEE EEEE EEEEE ccc
// cccc ccccc a aaaa aaaaa U z zzzz O OOOO v vvvv that the calendar has: U
// only for chinese and dangi, the G symbols for every calendar but chinese,
// dangi and iso8601. Throws for any other value, if there is no data, or if
// dateTimeFormat already has native state.
HERMES_INTL_HELPER(
    dateTimeFormatInit, Undefined, Object, Utf8, Utf8, Utf8, Utf8)
// (dateTimeFormat, epochMs) ToLocalTime of the time value epochMs, an integer
// within +-8.64e15, and the text of the symbols at that instant: 0 [[Weekday]]
// ("0" Sunday to "6"); 1 [[Era]], ICU4X's era code ("ce", "reiwa"), "" for
// chinese, dangi and iso8601; 2 [[Year]], the era year, the cyclic year 1-60
// of chinese and dangi, or the ISO year of iso8601; 3 [[RelatedYear]], the
// ISO year of chinese and dangi, else ""; 4 the month number shown, the
// ordinal month, or the number of the month code for chinese and dangi; 5 the
// month code ("M04L"); 6 "1" for a leap month, else "0"; 7-11 [[Day]],
// [[Hour]], [[Minute]], [[Second]], [[Millisecond]]; 12 [[InDST]], "1" or "0";
// 13 the UTC offset in seconds; 14 + i the text of symbol i. Zone names have
// ASCII digits. Throws for any other epochMs, or if dateTimeFormatInit did
// not initialize dateTimeFormat.
HERMES_INTL_HELPER(dateTimeFormatLocalTime, Utf8List, Object, Double)
