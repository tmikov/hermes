*~
*#
TAGS

# Howtoeven
.howtoeven

# buck
buck-out
.buckd
.buckconfig.local

# Python
*.pyc

# Mac
.DS_Store


# VS Code and Visual Studio
.vs
.vscode

.git/
.idea/
cmake-build*/
# Also match a bare name, so a `cmake-build-asan` SYMLINK pointing at a real
# build dir is ignored too — the Rust differential harnesses resolve the oracle
# through that exact path, so pointing it at another build tree is a normal
# thing to do.
cmake-build*

# clangd cache
/.cache/

# Compilation database
/compile_commands.json

# Rust build output (criterion writes target/ at the repo root when benches
# are run from here; rust/.gitignore covers rust/target)
/target
