// JS driver for e2e-mv-ref-import.wat.

var hbcPath = hermescli.getScriptArgs()[0];

// Distinguishable identities: a bare object cannot be reconstructed from a
// number, so `same=true` can only hold if the value itself survived.
var token = {tag: 'host'};
function seven() {
  return 7;
}

var inst = new WebAssembly.Instance(
  WebAssembly.Module.fromHermesBytecode(hermescli.loadFile(hbcPath)),
  {
    env: {
      pairExtern: function () {
        return [11, token];
      },
      pairFunc: function () {
        return [22, seven];
      },
    },
  });

print('importedExtern: same=' + (inst.exports.importedExtern() === token));
print('importedNum: ' + inst.exports.importedNum());

var f = inst.exports.importedFunc();
print('importedFunc: ' + typeof f + ' same=' + (f === seven) +
      ' calls -> ' + f());
