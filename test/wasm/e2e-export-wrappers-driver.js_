// JS driver for e2e-export-wrappers.wat.
// Tests export wrapper functions with various argument types.

var hbcPath = hermescli.getScriptArgs()[0];
var bytes = hermescli.loadFile(hbcPath);
var mod = WebAssembly.Module.fromHermesBytecode(bytes);
var instance = new WebAssembly.Instance(mod);
var exports = instance.exports;

// Test 1: basic i32 add.
print("add(3, 4) =", exports.add(3, 4));

// i32 overflow via wrapper coercion (AsInt32Inst).
print("add(2147483647, 1) =", exports.add(2147483647, 1));

// Test 2: void function returns undefined.
var result = exports.set_mem(42);
print("set_mem returned:", result);

// Verify the void function actually executed.
print("get_mem after set_mem(42) =", exports.get_mem());

// Test 3: f64 return value.
print("f64_add(1.5, 2.25) =", exports.f64_add(1.5, 2.25));

// Test 4: f32 return value.
print("f32_mul(3, 4) =", exports.f32_mul(3, 4));

// Test 5: mixed i32 and f64 params.
print("mixed(10, 3.5) =", exports.mixed(10, 3.5));
