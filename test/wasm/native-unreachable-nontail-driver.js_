// Driver for native-unreachable-nontail.wat, run both against the natively
// compiled unit and, so the two backends' behavior is checked against the
// same expectations, against the same module compiled to bytecode. The
// bytecode path is selected when hermescli (present only under
// -Xhermes-internal-test-methods) was given a script argument to load;
// otherwise this falls back to the linked-in native unit.

var mod;
if (typeof hermescli !== 'undefined' && hermescli.getScriptArgs().length > 0) {
  mod = WebAssembly.Module.fromHermesBytecode(
      hermescli.loadFile(hermescli.getScriptArgs()[0]));
} else {
  mod = WebAssembly.Module.fromNativeUnit('nontailmod');
}
var e = new WebAssembly.Instance(mod, {}).exports;

function run(label, fn) {
  try {
    print(label + ': ' + fn());
  } catch (err) {
    print(label + ': trapped');
  }
}

run('tail()', function() { return e.tail(); });
run('inBlock()', function() { return e.inBlock(); });
run('mixed(1)', function() { return e.mixed(1); });
run('mixed(0)', function() { return e.mixed(0); });

print('done');
