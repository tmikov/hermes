// JS driver for e2e-elem-mixed-items.wat.
//
// Every table assertion is an identity comparison printed as a boolean.
// Printing the value instead would not separate the outcome slot 1 is about.
// An Exported Function stringifies as "function wasm_export_f0() {
// [bytecode] }" -- named after the Wasm function, not after the instance --
// so the value that came in through the funcref global and this instance's
// own f0 print the same text, and only `===` tells them apart.

var args = hermescli.getScriptArgs();
var mod = WebAssembly.Module.fromHermesBytecode(hermescli.loadFile(args[0]));

function instantiate(gf, ge) {
  return new WebAssembly.Instance(mod, {e: {gf: gf, ge: ge}}).exports;
}

var extObj = {tag: 'ext'};

// A first instantiation, only to obtain a WebAssembly Exported Function to
// hand to the funcref global of the second. Its f0 is a different object
// from the second instance's f0, which is what lets slot 1 distinguish the
// value that came in through the global from the one the module supplies
// itself.
var seedFn = instantiate(null, null).f0;

var ex = instantiate(seedFn, extObj);
var t = ex.t;

print("slot 0 is this instance's f0: " + (t.get(0) === ex.f0));
print('slot 1 is the imported function: ' + (t.get(1) === seedFn));
print("slot 1 is not this instance's f1: " + (t.get(1) !== ex.f1));
print('slot 2 is null: ' + (t.get(2) === null));
print("slot 3 is this instance's f1: " + (t.get(3) === ex.f1));
print('slot 4 is null: ' + (t.get(4) === null));

for (var i = 1; i <= 3; ++i) {
  try {
    print('call(' + i + '): ' + ex.call(i));
  } catch (e) {
    print('call(' + i + '): ' + e.message);
  }
}

print('externref slot 0 is the imported object: ' + (ex.eget(0) === extObj));
print('externref slot 1 is null: ' + (ex.eget(1) === null));
print('done');
