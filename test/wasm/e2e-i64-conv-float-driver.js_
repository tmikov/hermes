// Driver script for e2e-i64-conv-float.wat

var hbcPath = hermescli.getScriptArgs()[0];
var bytes = hermescli.loadFile(hbcPath);
var mod = new WebAssembly.Module(bytes);
var instance = new WebAssembly.Instance(mod);
var exports = instance.exports;

print("f64_convert_i64_s_small: " + exports.f64_convert_i64_s_small());
print("f64_convert_i64_s_neg: " + exports.f64_convert_i64_s_neg());
print("f64_convert_i64_u_small: " + exports.f64_convert_i64_u_small());
print("f32_convert_i64_s_small: " + exports.f32_convert_i64_s_small());
print("f32_convert_i64_u_small: " + exports.f32_convert_i64_u_small());
print("f64_reinterpret_i64_one: " + exports.f64_reinterpret_i64_one());
print("f64_reinterpret_i64_zero: " + exports.f64_reinterpret_i64_zero());
print("reinterpret_roundtrip: " + exports.reinterpret_roundtrip());
