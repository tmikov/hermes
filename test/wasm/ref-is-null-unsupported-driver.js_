// JS driver for ref-is-null-unsupported.wat.

var hbcPath = hermescli.getScriptArgs()[0];
var inst = new WebAssembly.Instance(
  new WebAssembly.Module(hermescli.loadFile(hbcPath)));
print('is_null_local: ' + inst.exports.is_null_local());
