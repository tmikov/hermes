;; Control module for e2e-reexport-limits.wat: a memory and a table this
;; module defines itself, so their exported limits must still come from the
;; declarations. The memory declares no maximum, which is the case the
;; "no maximum" sentinel has to survive.

(module
  (memory (export "mem") 1)
  (table (export "tbl") 3 7 funcref))
