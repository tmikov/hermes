// JS driver for e2e-elem-global-offset-order.wat.
// An active element segment offset by `global.get $g` (g = 2) must place its
// two functions at table slots 2 and 3, leaving every other slot
// uninitialized.

var hbcPath = hermescli.getScriptArgs()[0];
var bytes = hermescli.loadFile(hbcPath);
var mod = WebAssembly.Module.fromHermesBytecode(bytes);
var instance = new WebAssembly.Instance(mod, {e: {g: 2}});
var exports = instance.exports;

for (var i = 0; i < 6; ++i) {
  try {
    print('slot ' + i + ': ' + exports.call(i));
  } catch (e) {
    print('slot ' + i + ': ' + e.message);
  }
}
print('done');
