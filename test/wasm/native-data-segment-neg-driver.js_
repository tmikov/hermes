try {
  new WebAssembly.Instance(
      WebAssembly.Module.fromNativeUnit('dnegmod'),
      {env: {mem: new WebAssembly.Memory({initial: 1})}});
  print('threw: false');
} catch (e) {
  print('threw: ' + true);
}
print('done');
