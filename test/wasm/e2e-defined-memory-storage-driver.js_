// JS driver for e2e-defined-memory-storage.wat.

var args = hermescli.getScriptArgs();
function load(i) {
  return WebAssembly.Module.fromHermesBytecode(hermescli.loadFile(args[i]));
}
var mod = load(0);
var consumerMod = load(1);

// --- The decoy buffer -----------------------------------------------------
//
// Replace WebAssembly.Memory.prototype.buffer for the duration of the
// instantiation. The descriptor is configurable, so this really does replace
// the route createMemoryViews() used to take when it built the module's own
// memory.
var decoy = new ArrayBuffer(4 * 65536);
var savedBuffer =
    Object.getOwnPropertyDescriptor(WebAssembly.Memory.prototype, 'buffer');
Object.defineProperty(WebAssembly.Memory.prototype, 'buffer', {
  get: function () { return decoy; },
  configurable: true,
});
// Observed through the property while the hijack is installed, so the line
// printed states what was true during instantiation and not what the native
// getter says once it is back.
var probe = new WebAssembly.Memory({initial: 1});
var hijackInForce = (probe.buffer === decoy);
var e = new WebAssembly.Instance(mod).exports;
Object.defineProperty(WebAssembly.Memory.prototype, 'buffer', savedBuffer);

print('hijacked buffer accessor was in force: ' + hijackInForce);

e.poke(512, 0xABCD);
print('wasm wrote into the script-supplied decoy: ' +
      (new DataView(decoy).getUint32(512, true) === 0xABCD));
print('wasm wrote into the exported memory: ' +
      (new DataView(e.mem.buffer).getUint32(512, true) === 0xABCD));

// --- The cross-module consequence -----------------------------------------
print('exported memory is a genuine Memory: ' +
      (e.mem instanceof WebAssembly.Memory));
var consumer = null;
try {
  consumer = new WebAssembly.Instance(consumerMod, {a: {mem: e.mem}}).exports;
  print('consumer links against the exported Memory: true');
} catch (err) {
  print('consumer links against the exported Memory: ' + err.name + ': ' +
        err.message);
}
print('exporter wrote 43981 at 512; consumer reads: ' +
      (consumer ? consumer.peek(512) : 'n/a'));

// --- A replaced constructor is ignored ------------------------------------
//
// globalThis.WebAssembly.Memory is an ordinary writable property, but
// createMemoryViews() reads the constructor from
// HermesInternal.intrinsics.WebAssembly instead, so replacing it no longer
// decides what a module's memory is.
var savedCtor = WebAssembly.Memory;
var replacementUsed = false;
WebAssembly.Memory = function () { replacementUsed = true; return {}; };
try {
  var ex = new WebAssembly.Instance(mod).exports;
  print('replaced Memory constructor: linked, size = ' + ex.size());
} catch (err) {
  print('replaced Memory constructor: ' + err.name + ': ' + err.message);
}
// The replacement really would have been used by anything that read it, so
// the line above is not passing because the replacement was inert.
new WebAssembly.Memory({initial: 1});
print('replaced Memory constructor was live: ' + replacementUsed);
WebAssembly.Memory = savedCtor;

// --- A tampered DESCRIPTOR still reaches the limits check -----------------
//
// The constructor is out of reach; the descriptor generated code hands it is
// not. That descriptor is an ordinary object literal and its stores walk the
// prototype chain, so accessors installed here swallow what the module wrote
// and answer the constructor's reads with numbers of their own. The result is
// a GENUINE WebAssembly.Memory carrying limits the module never declared,
// while memory.grow on a defined memory keeps using the compile-time literal
// -- so a smaller maximum gets grown past its own ceiling and ends up with
// maxPages_ inconsistent with its buffer.
//
// Nothing inside these accessors assigns to another object: every ordinary
// object inherits from Object.prototype, so that would re-enter them.
function withDescriptor(label, initialVal, maximumVal) {
  var installed = [];
  function install(name, value) {
    Object.defineProperty(Object.prototype, name, {
      get: function () { return value; },
      set: function (v) {},
      configurable: true,
    });
    installed.push(name);
  }
  install('initial', initialVal);
  install('maximum', maximumVal);
  try {
    var ex = new WebAssembly.Instance(mod).exports;
    print(label + ': linked, size = ' + ex.size());
  } catch (err) {
    print(label + ': ' + err.name + ': ' + err.message);
  }
  for (var i = 0; i < installed.length; i++)
    delete Object.prototype[installed[i]];
}
// The module declares (memory 1 4). `undefined` for the maximum is how the
// descriptor spells "no maximum".
withDescriptor('descriptor said 1 page, no maximum', 1, undefined);
withDescriptor('descriptor said 1 page, maximum 2', 1, 2);
withDescriptor('descriptor said 2 pages, maximum 4', 2, 4);
withDescriptor('descriptor said exactly what was declared', 1, 4);
print('done');
