// JS driver for e2e-memory.wat.

var hbcPath = hermescli.getScriptArgs()[0];
var bytes = hermescli.loadFile(hbcPath);
var mod = new WebAssembly.Module(bytes);
var instance = new WebAssembly.Instance(mod);
var exports = instance.exports;

// i32 store/load round-trip.
print("store_load_i32(42) =", exports.store_load_i32(42));
print("store_load_i32(-1) =", exports.store_load_i32(-1));

// i32.load8_u / i32.load8_s after i32.store.
print("store_load8_u(0xFF) =", exports.store_load8_u(0xFF));
print("store_load8_s(0xFF) =", exports.store_load8_s(0xFF));
print("store_load8_u(0x80) =", exports.store_load8_u(0x80));
print("store_load8_s(0x80) =", exports.store_load8_s(0x80));

// i32.load16_u / i32.load16_s after i32.store.
print("store_load16_u(0xFFFF) =", exports.store_load16_u(0xFFFF));
print("store_load16_s(0xFFFF) =", exports.store_load16_s(0xFFFF));
print("store_load16_u(0x8000) =", exports.store_load16_u(0x8000));
print("store_load16_s(0x8000) =", exports.store_load16_s(0x8000));

// i32.store8 truncates to lower byte.
print("store8_load8(0xFF) =", exports.store8_load8(0xFF));
print("store8_load8(0x100) =", exports.store8_load8(0x100));

// i32.store16 truncates to lower 16 bits.
print("store16_load16(0xFFFF) =", exports.store16_load16(0xFFFF));
print("store16_load16(0x10000) =", exports.store16_load16(0x10000));

// f64 round-trip.
print("f64 =", exports.store_load_f64(3.141592653589793));

// f32 round-trip (value should survive float precision).
var f32Result = exports.store_load_f32(1.5);
print("f32 round-trip", f32Result === 1.5 ? "ok" : "FAIL: " + f32Result);

// Load at offset.
print("load_at_offset =", exports.load_at_offset(42, 99));

// Boundary access (last valid i32 address in 1 page).
print("boundary =", exports.boundary(12345));
