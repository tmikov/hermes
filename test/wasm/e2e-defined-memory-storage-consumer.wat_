;; Consumer for e2e-defined-memory-storage.wat: imports the exporter's
;; memory and reads from it. Its own link path already brand-checks the
;; supplied object and takes the buffer out of the internal field, so if it
;; reads zeros the fault is on the exporting side.

(module
  (import "a" "mem" (memory 1 4))
  (func (export "peek") (param i32) (result i32)
    local.get 0
    i32.load))
