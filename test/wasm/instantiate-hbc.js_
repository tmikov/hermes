// Instantiation-only driver: loads a compiled Wasm HBC module and
// instantiates it via WebAssembly API. Used for tests that expect
// traps during instantiation (e.g., start function traps, OOB data
// segments). The trap error will propagate to the caller.
//
// Usage: hermes -Xhermes-internal-test-methods instantiate-hbc.js_ -- <hbc-path>

var args = hermescli.getScriptArgs();
var hbcPath = args[0];
var bytes = hermescli.loadFile(hbcPath);
var mod = new WebAssembly.Module(bytes);
var instance = new WebAssembly.Instance(mod);
