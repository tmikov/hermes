var e = new WebAssembly.Instance(
    WebAssembly.Module.fromNativeUnit('trapmod'), {}).exports;
var caught = false;
try {
  e.boom();
} catch (err) {
  caught = true;
}
print('caught: ' + caught);
print('done');
