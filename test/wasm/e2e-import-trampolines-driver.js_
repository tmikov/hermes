// JS driver for e2e-import-trampolines.wat.
// Sets up import functions, loads the compiled Wasm module, and tests
// that imported functions are called correctly.

var hbcPath = hermescli.getScriptArgs()[0];

// Set up the imports object for the Wasm module.
var imports = {
  env: {
    // Test 1: log function that prints its argument.
    log: function(x) {
      print("log:", x);
    },

    // Test 2: add function that returns the sum.
    add: function(a, b) {
      return a + b;
    },

    // Test 3: function that throws.
    throwing: function() {
      throw new Error("import threw");
    },
  },
};

var bytes = hermescli.loadFile(hbcPath);
var mod = new WebAssembly.Module(bytes);
var instance = new WebAssembly.Instance(mod, imports);
var exports = instance.exports;

// Test 1: call log.
exports.call_log(42);
exports.call_log(-7);

// Test 2: call add and use result.
print("add(3, 4) =", exports.call_add(3, 4));
print("add(100, 200) =", exports.call_add(100, 200));

// Test 3: call throwing function — verify exception propagates.
try {
  exports.call_throw();
  print("ERROR: should have thrown");
} catch (e) {
  print("caught:", e.message);
}
