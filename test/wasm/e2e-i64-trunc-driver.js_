// JS driver for e2e-i64-trunc.wat.

var hbcPath = hermescli.getScriptArgs()[0];
var bytes = hermescli.loadFile(hbcPath);
var mod = new WebAssembly.Module(bytes);
var instance = new WebAssembly.Instance(mod);
var exports = instance.exports;

print("trunc_s_lo:", exports.trunc_s_lo());
print("trunc_s_neg:", exports.trunc_s_neg());
print("trunc_u_hi:", exports.trunc_u_hi());
print("trunc_u_full:", exports.trunc_u_full());
print("trunc_s_zero:", exports.trunc_s_zero());
print("sat_s_nan:", exports.sat_s_nan());
print("sat_u_neg:", exports.sat_u_neg());
print("sat_s_overflow:", exports.sat_s_overflow());
print("sat_u_large:", exports.sat_u_large());
print("trunc_f32_s:", exports.trunc_f32_s());
print("sat_f32_nan:", exports.sat_f32_nan());
