// Driver for regress-i64-export-wrapper.wat: calls test_neg_div with BigInt args.
var args = hermescli.getScriptArgs();
var hbcPath = args[0];
var bytes = hermescli.loadFile(hbcPath);
var mod = WebAssembly.Module.fromHermesBytecode(bytes);
var instance = new WebAssembly.Instance(mod);
var exports = instance.exports;

// i64 export wrappers expect BigInt arguments.
var result = exports.test_neg_div(BigInt("-5"), BigInt("2"));
print(result.toString());
