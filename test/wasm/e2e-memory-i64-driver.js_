// JS driver for e2e-memory-i64.wat.

var hbcPath = hermescli.getScriptArgs()[0];
var bytes = hermescli.loadFile(hbcPath);
var mod = new WebAssembly.Module(bytes);
var instance = new WebAssembly.Instance(mod);
var exports = instance.exports;

print("i64_store_load_lo =", exports.i64_store_load_lo());
print("i64_store_load_hi =", exports.i64_store_load_hi());
print("i64_store8_load8 =", exports.i64_store8_load8());
print("i64_store16_load16 =", exports.i64_store16_load16());
print("i64_store32_load32 =", exports.i64_store32_load32());
print("i64_load8_u =", exports.i64_load8_u());
print("i64_load8_s =", exports.i64_load8_s());
print("i64_load16_u =", exports.i64_load16_u());
print("i64_load16_s =", exports.i64_load16_s());
print("i64_load32_u =", exports.i64_load32_u());
print("i64_load32_s_hi =", exports.i64_load32_s_hi());
