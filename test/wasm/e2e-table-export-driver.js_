// JS driver for e2e-table-export.wat.
// The exported table is a genuine WebAssembly.Table with no own properties:
// the metadata and backing arrays it used to publish were the linking ABI,
// and the link path now reads them from internal fields behind a brand check.

var hbcPath = hermescli.getScriptArgs()[0];
var bytes = hermescli.loadFile(hbcPath);
var mod = WebAssembly.Module.fromHermesBytecode(bytes);
var instance = new WebAssembly.Instance(mod);
var exports = instance.exports;

print("tbl type:", typeof exports.tbl);
print("tbl instanceof WebAssembly.Table:",
      exports.tbl instanceof WebAssembly.Table);
print("tbl.length:", exports.tbl.length);
print("tbl own props: [" +
      Object.getOwnPropertyNames(exports.tbl).join(", ") + "]");
print("tbl JSON: " + JSON.stringify(exports.tbl));

// The maximum is no longer reported anywhere, so the only way to see that it
// survived is to grow against it.
print("grow to the maximum: " + exports.tbl.grow(5) +
      ", length " + exports.tbl.length);
try {
  exports.tbl.grow(1);
  print("grow past the maximum: grew, length " + exports.tbl.length);
} catch (e) {
  print("grow past the maximum: " + e.name + ", length " + exports.tbl.length);
}
