// JS driver for e2e-copysign.wat.

var hbcPath = hermescli.getScriptArgs()[0];
var bytes = hermescli.loadFile(hbcPath);
var mod = new WebAssembly.Module(bytes);
var instance = new WebAssembly.Instance(mod);
var exports = instance.exports;

print("f64.copysign(1, -1) =", exports.f64_copysign(1, -1));
print("f64.copysign(-1, 1) =", exports.f64_copysign(-1, 1));
print("f64.copysign(5.5, -3) =", exports.f64_copysign(5.5, -3));
print("f32.copysign(1, -1) =", exports.f32_copysign(1, -1));
print("f32.copysign(-1, 1) =", exports.f32_copysign(-1, 1));
print("f32.copysign(5.5, -3) =", exports.f32_copysign(5.5, -3));
