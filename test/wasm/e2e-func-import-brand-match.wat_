;; Consumer for e2e-func-import-brand.wat, declaring the import with the
;; signature the exporter actually has.
(module
  (import "a" "f" (func $f (param i32) (result i32)))
  (func (export "call") (param i32) (result i32) (call $f (local.get 0))))
