;; Exporter for e2e-cross-module-tag.wat. Declares tags a (its index 0) and
;; b (1), and throws a.

(module
  (tag $a (export "a") (param i32))
  (tag $b (export "b") (param i32))
  (func (export "boom_a") (param i32) (throw $a (local.get 0))))
