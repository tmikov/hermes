;; Companion module for e2e-memory-import-metadata.wat: a memory import with
;; NO declared maximum, so nothing validates __wasm_max__ and whatever script
;; supplies is stored and later handed to a native builtin.

(module
  (import "e" "m" (memory 1))
  (func (export "grow") (result i32) (memory.grow (i32.const 1))))
