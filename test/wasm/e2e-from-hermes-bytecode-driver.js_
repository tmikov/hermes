var hbc = hermescli.loadFile(hermescli.getScriptArgs()[0]);
try {
  var mod = WebAssembly.Module.fromHermesBytecode(hbc);
  var inst = new WebAssembly.Instance(mod);
  print('gated on: f() = ' + inst.exports.f());
} catch (e) {
  print('gated off: ' + e.name);
}
