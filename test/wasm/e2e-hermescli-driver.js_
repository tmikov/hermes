// JS driver for e2e-hermescli.wat.
// Loads a compiled Wasm module via WebAssembly API and calls its exports.

var hbcPath = hermescli.getScriptArgs()[0];
var bytes = hermescli.loadFile(hbcPath);
var mod = new WebAssembly.Module(bytes);
var instance = new WebAssembly.Instance(mod);
var exports = instance.exports;

print("exports type:", typeof exports);
print("add(3, 4) =", exports.add(3, 4));
print("sub(10, 3) =", exports.sub(10, 3));
print("mul(6, 7) =", exports.mul(6, 7));
