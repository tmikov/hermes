// JS driver for e2e-imported-global-index.wat.

var args = hermescli.getScriptArgs();
var mod = new WebAssembly.Module(hermescli.loadFile(args[0]));
var inst = new WebAssembly.Instance(mod, {e: {base: 9}});

print('base = ' + inst.exports.base());
print('a = ' + inst.exports.a());
print('b = ' + inst.exports.b());
print('c = ' + inst.exports.c());
print('done');
