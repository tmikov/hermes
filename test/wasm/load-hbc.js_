// General-purpose driver: loads a compiled Wasm HBC module and calls
// an exported function, printing the result.
//
// Usage: hermes -Xhermes-internal-test-methods load-hbc.js_ -- <hbc-path> <func-name> [args...]

var args = hermescli.getScriptArgs();
var hbcPath = args[0];
var funcName = args[1];
var exports = hermescli.loadHBC(hermescli.loadFile(hbcPath));

var callArgs = [];
for (var i = 2; i < args.length; i++) {
  callArgs.push(+args[i]);
}

print(exports[funcName].apply(null, callArgs));
