;; Consumer module for e2e-table-abi-private.wat. It imports a funcref table
;; and does nothing with it but report its size, so that "did this value link
;; as a table?" is the only thing the driver is asking.

(module
  (import "e" "t" (table 2 funcref))
  (func (export "size") (result i32) (table.size 0)))
