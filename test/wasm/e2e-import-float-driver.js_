// JS driver for e2e-import-float.wat.
// Tests importing JS functions with float arguments and return values.

var hbcPath = hermescli.getScriptArgs()[0];

var imports = {
  env: {
    // f64 add
    f64_add: function(a, b) {
      return a + b;
    },
    // f64 -> i32 comparison
    f64_gt: function(a, b) {
      return a > b ? 1 : 0;
    },
  },
};

var bytes = hermescli.loadFile(hbcPath);
var mod = WebAssembly.Module.fromHermesBytecode(bytes);
var instance = new WebAssembly.Instance(mod, imports);
var exports = instance.exports;

print("f64_result(1.5, 2.25) =", exports.test_f64(1.5, 2.25));
print("gt(3.0, 2.0) =", exports.test_gt(3.0, 2.0));
print("gt(1.0, 5.0) =", exports.test_gt(1.0, 5.0));
