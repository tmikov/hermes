// JS driver for e2e-escapable-float-param.wat.

var hbcPath = hermescli.getScriptArgs()[0];
var inst = new WebAssembly.Instance(
    WebAssembly.Module.fromHermesBytecode(hermescli.loadFile(hbcPath)), {});

// The internal closures, reached directly via the exported table.
var f64 = inst.exports.tbl.get(0);
var f32 = inst.exports.tbl.get(1);

print('f64 closure(2.5, 4.0) = ' + f64(2.5, 4.0));
print('f64 closure("x", "y") = ' + f64('x', 'y'));
print('f32 closure(1.5, 2.25) = ' + f32(1.5, 2.25));
print('f32 closure({}, 1) = ' + f32({}, 1));

print('add_direct(10.5, 0.25) = ' + inst.exports.add_direct(10.5, 0.25));
print('done');
