// JS driver for e2e-call-indirect.wat.
// Tests correct dispatch, out-of-bounds, null entry, and type mismatch.

var hbcPath = hermescli.getScriptArgs()[0];
var bytes = hermescli.loadFile(hbcPath);
var mod = new WebAssembly.Module(bytes);
var instance = new WebAssembly.Instance(mod);
var exports = instance.exports;

// Test 1: Correct dispatch — call functions at known indices.
print("call f0:", exports.call_type0(0));
print("call f1:", exports.call_type0(1));

// Test 2: Correct dispatch with arguments.
print("call f2(5):", exports.call_type1(3, 5));

// Test 3: Out of bounds index.
try {
  exports.call_type0(10);
  print("ERROR: should have trapped");
} catch (e) {
  print("oob:", e.message);
}

// Test 4: Uninitialized table entry (index 2 was never set).
try {
  exports.call_type0(2);
  print("ERROR: should have trapped");
} catch (e) {
  print("null entry:", e.message);
}

// Test 5: Type mismatch — call f2 (type 1) with type 0 signature.
try {
  exports.call_type0(3);
  print("ERROR: should have trapped");
} catch (e) {
  print("type mismatch:", e.message);
}
