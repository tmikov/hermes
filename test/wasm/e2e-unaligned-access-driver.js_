// JS driver for e2e-unaligned-access.wat.

var hbcPath = hermescli.getScriptArgs()[0];
var bytes = hermescli.loadFile(hbcPath);
var mod = new WebAssembly.Module(bytes);
var instance = new WebAssembly.Instance(mod);
var exports = instance.exports;

// Test 1: i32.store/load at an odd address (align=1).
exports.store_i32_u1(1, 0xDEADBEEF);
var val = exports.load_i32_u1(1);
// 0xDEADBEEF as signed i32 is -559038737.
print("i32 odd addr: " + (val === -559038737 ? "PASS" : "FAIL got " + val));

// Test 2: i32.store/load at a 2-byte-aligned but not 4-byte-aligned addr
// using align=2.
exports.store_i32_u2(6, 0x12345678);
var val2 = exports.load_i32_u2(6);
print("i32 align2: " + (val2 === 0x12345678 ? "PASS" : "FAIL got " + val2));

// Test 3: f64 round-trip at an odd address using align=1.
exports.store_f64_u1(3, 3.141592653589793);
var val3 = exports.load_f64_u1(3);
print("f64 odd addr: " + (val3 === 3.141592653589793 ? "PASS" : "FAIL got " + val3));

// Test 4: i32 round-trip with aligned store, unaligned load at same aligned addr.
// This verifies the byte-assembly path reads what the typed array path wrote.
exports.store_i32_aligned(16, 0x7FFFFFFF);
var val4 = exports.load_i32_u1(16);
print("aligned-store unaligned-load: " + (val4 === 0x7FFFFFFF ? "PASS" : "FAIL got " + val4));

// Test 5: unaligned store, aligned load at same aligned addr.
// This verifies the byte-decomposition path writes what the typed array path reads.
exports.store_i32_u1(20, 0x0A0B0C0D);
var val5 = exports.load_i32_aligned(20);
print("unaligned-store aligned-load: " + (val5 === 0x0A0B0C0D ? "PASS" : "FAIL got " + val5));

// Test 6: i16 unaligned store/load with sign extension.
exports.store_i16_u1(31, 0xFF80); // -128 as i16.
var val6s = exports.load_i16s_u1(31);
var val6u = exports.load_i16u_u1(31);
print("i16s unaligned: " + (val6s === -128 ? "PASS" : "FAIL got " + val6s));
print("i16u unaligned: " + (val6u === 0xFF80 ? "PASS" : "FAIL got " + val6u));

// Test 7: f32 round-trip at an odd address using align=1.
exports.store_f32_u1(41, 2.5);
var val7 = exports.load_f32_u1(41);
print("f32 odd addr: " + (val7 === 2.5 ? "PASS" : "FAIL got " + val7));
