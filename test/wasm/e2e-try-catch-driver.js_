// JS driver for e2e-try-catch.wat.
// Provides the print import and runs the Wasm module's exported test functions.

var hbcPath = hermescli.getScriptArgs()[0];

globalThis.__wasm_imports__ = {
  env: {
    print: function(x) {
      print(x);
    },
  },
};

var exports = hermescli.loadHBC(hermescli.loadFile(hbcPath));

exports._main();
