// JS driver for e2e-try-catch.wat.
// Provides the print import and runs the Wasm module's exported test functions.

var hbcPath = hermescli.getScriptArgs()[0];

var imports = {
  env: {
    print: function(x) {
      print(x);
    },
  },
};

var bytes = hermescli.loadFile(hbcPath);
var mod = WebAssembly.Module.fromHermesBytecode(bytes);
var instance = new WebAssembly.Instance(mod, imports);
var exports = instance.exports;

exports._main();
