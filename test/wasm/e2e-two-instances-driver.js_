// JS driver for e2e-two-instances.wat.

var mod = WebAssembly.Module.fromHermesBytecode(
  hermescli.loadFile(hermescli.getScriptArgs()[0]));

var a = new WebAssembly.Instance(
  mod, {e: {base: 100, f: function (x) { return x * 10; }}});
var b = new WebAssembly.Instance(
  mod, {e: {base: 2000, f: function (x) { return x; }}});

print('a.run(1) = ' + a.exports.run(1));
print('b.run(1) = ' + b.exports.run(1));
// The first instance must be unaffected by the second's instantiation.
print('a.run(1) again = ' + a.exports.run(1));
print('no global leaked: ' +
      (typeof globalThis.__wasm_imports__ === 'undefined'));
print('done');
