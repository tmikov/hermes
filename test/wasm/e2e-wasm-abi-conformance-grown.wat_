;; Companion module for e2e-wasm-abi-conformance.wat, used for H7: it declares
;; a minimum of TWO pages, so it links only against a memory whose CURRENT
;; size is at least two. A memory constructed with one page and grown to two
;; satisfies it; a recorded snapshot of the size at construction does not.

(module
  (import "e" "m" (memory 2))
  (func (export "size") (result i32) memory.size))
